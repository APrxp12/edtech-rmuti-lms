# Google Cloud OAuth 2.0 Web Client ID
# สร้างได้จาก Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application)
# ระบุ Authorized JavaScript origins:
#   - http://localhost:3000
#   - https://edtech-rmuti-lms.vercel.app
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Supabase Cloud Database (PostgreSQL)
# สร้างฟรีได้ที่ https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
